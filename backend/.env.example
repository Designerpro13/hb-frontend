APP_ENV=development
API_TOKEN=change-this-long-random-token
ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_PER_MINUTE=120

# FIX (issue #1): Secrets moved from source code to environment variables.
# Generate strong random values for each of these before deploying.
# Never commit the actual .env file.
ADMIN_TOKEN=change-this-to-a-long-random-secret
DB_PASSWORD=change-this-to-a-strong-db-password
DB_CONNECTION_STRING=mysql://admin:change-this-to-a-strong-db-password@localhost:3306/ctf_db
